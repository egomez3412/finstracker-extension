{
  "manifest_version": 3,
  "name": "Finstracker Sync",
  "version": "1.0.0",
  "description": "Sync card points from issuer sites, track credits and offers, and see the best card to use at checkout.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "notifications",
    "sidePanel",
    "webNavigation"
  ],
  "host_permissions": [
    "https://finstracker.com/*",
    "https://*.finstracker.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.americanexpress.com/*",
    "https://*.chase.com/*",
    "https://*.capitalone.com/*",
    "https://*.citi.com/*",
    "https://*.citibank.com/*",
    "https://*.discover.com/*",
    "https://*.wellsfargo.com/*",
    "https://*.bankofamerica.com/*",
    "https://*.usbank.com/*",
    "https://*.barclaycardus.com/*",
    "https://*.delta.com/*",
    "https://*.united.com/*",
    "https://*.southwest.com/*",
    "https://*.aa.com/*",
    "https://*.alaskaair.com/*",
    "https://*.jetblue.com/*",
    "https://*.aircanada.com/*",
    "https://*.britishairways.com/*",
    "https://*.flyingblue.com/*",
    "https://*.marriott.com/*",
    "https://*.hilton.com/*",
    "https://*.hyatt.com/*",
    "https://*.ihg.com/*",
    "https://*.wyndhamhotels.com/*",
    "https://*.choicehotels.com/*",
    "https://*.amazon.com/*",
    "https://*.biltrewards.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://finstracker.com/*",
      "https://*.finstracker.com/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*",
      "http://localhost:5175/*",
      "http://127.0.0.1:5175/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Finstracker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/picker.css",
        "content/picker.js",
        "content/prompt.css",
        "content/prompt.js",
        "content/checkout.css",
        "content/checkout.js",
        "icons/icon-16.png",
        "icons/icon-32.png",
        "icons/icon-48.png",
        "icons/icon-128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
