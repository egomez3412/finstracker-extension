{
  "manifest_version": 3,
  "name": "Finstracker \u2014 Sync",
  "version": "0.2.0",
  "description": "Capture credit card points from issuer portals and sync them to your Finstracker profile.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "notifications",
    "sidePanel",
    "webNavigation"
  ],
  "host_permissions": [
    "https://finstracker.com/*",
    "https://*.finstracker.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.americanexpress.com/*",
    "https://*.chase.com/*",
    "https://*.capitalone.com/*",
    "https://*.citi.com/*",
    "https://*.citibank.com/*",
    "https://*.discover.com/*",
    "https://*.wellsfargo.com/*",
    "https://*.bankofamerica.com/*",
    "https://*.usbank.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://finstracker.com/*",
      "https://*.finstracker.com/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Finstracker \u2014 Sync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [],
  "web_accessible_resources": [
    {
      "resources": [
        "content/picker.css",
        "content/picker.js",
        "content/prompt.css",
        "content/prompt.js",
        "favicon.svg",
        "icons/icon-16.png",
        "icons/icon-32.png",
        "icons/icon-48.png",
        "icons/icon-128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
